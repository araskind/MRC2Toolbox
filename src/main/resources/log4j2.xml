<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG">
    <!-- Appenders define where logs are sent -->
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender Definition -->
        <RollingFile name="RollingFileAppender" 
                     fileName="data/logs/MRC2Toolbox.log" 
                     filePattern="data/logs/archive/MRC2Toolbox-%d{yyyy-MM-dd}-%i.log.gz">
            
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
            
            <Policies>
                <!-- 1. Time-Based Rotation: Rotates every day -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                
                <!-- 2. Size-Based Rotation: Rotates when file hits 10 Megabytes -->
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            
            <!-- Retention Strategy: Keeps a maximum of 20 archived files -->
            <DefaultRolloverStrategy max="20" />
        </RollingFile>
    </Appenders>

    <!-- Loggers control the severity threshold and activate appenders -->
    <Loggers>
        <Root level="DEBUG">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFileAppender" />
        </Root>
    </Loggers>
</Configuration>